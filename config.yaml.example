server:
  game_port: 10070
  auth_port: 9735
  patch_port: 7000
  account_port: 8080

  bind_address: "0.0.0.0"

  # REQUIRED. The address the CLIENT is told to connect to -- it goes into the
  # server list and into the patch XML, so it must be reachable from the PS2 /
  # PCSX2 host. It is NOT necessarily bind_address, and it is never "localhost".
  #
  # If the PS2's address is an alias on this same machine, bind_address must be
  # the specific address too, not 0.0.0.0: a UDP socket bound to 0.0.0.0 can
  # reply from the wrong local address, and the client silently drops it. TCP is
  # unaffected, so the symptom is auth and patching working while the server
  # list stays empty.
  server_ip: "192.168.1.100"

  # SQLite database file. Copy eqoa.seed.db here to start.
  db_path: "eqoa.db"

  # Applied to the patch server's HTTP listener.
  read_timeout: 5s
  write_timeout: 5s

  # Every packet's own debug lines in the log (received, sent, DRDP, state
  # channels): about 100 lines a second a player, so off unless set. A GM's
  # #packetlog turns them on or off while the server runs. cmd/movereplay reads
  # a log written with them on.
  # packet_log: false

  # What the process holds beyond what it uses. gc_percent is GOGC (unset: Go's
  # 100, the heap floats to twice what is live; 25 costs next to nothing here, nearly
  # all that is live being the NPCs). no_huge_pages stops the kernel's transparent
  # huge pages, which on "always" fill back what the runtime gives up.
  # gc_percent: 25
  # no_huge_pages: true

world:
  tick_rate: 100ms

  # Time a session may sit at character select before it is dropped. The 45s
  # default is not enough for a human reading the list.
  session_timeout_pre: 300s
  session_timeout_game: 2s

  # Lets players flag themselves for PvP with /pvp (or /t pvp from a PS2): two
  # flagged players can attack each other anywhere. Off unless set.
  # pvp: true

  # Lets players jump (entity/jump.go): a client that can (vanilla, opcode
  # 0x7E28) is offered it and jumps about 0.9 up, and the check of players' own
  # moves takes a jump's arc from it. A PS2 cannot jump and is never offered it.
  # Off unless set.
  # jump: true

  # A monster's name and level, and nothing else, when a player presses the
  # talk button on it (square; Q on vanilla's keyboard) and it has nothing to
  # say, or stands out of the talk's reach (handlers/mobinfo.go). Vanilla
  # (offered it with opcode 0x7E4C) shows them in the target's details box, as
  # a player's, while the button is held; a PS2 in a dialogue box. Off unless
  # set (the Heirloom Test Server sets it).
  # mob_info: true

  # The accounts (accountinfo.username) whose GMs may /noclip: a flight through
  # every wall, floor and ceiling (handlers/noclip.go). Empty: nobody.
  # noclip_accounts: [someaccount]

  # What an NPC says when talked to, by name, in place of the debug box
  # (ServerID, HP, position...) every other NPC opens.
  npc_text:
    "Freeport Announcements": "Welcome to the server."

  # For testing: the level a new character starts at (1 when unset; a
  # client's creation message never chooses it), and whether it starts with
  # every spell its class has (the classspells table, filled by
  # tools/import_class_spells.py).
  # start_level: 50
  # start_all_spells: true

  # Character creation past the game's own (entity/creation.go): the froglok
  # and every race of table racedefs (a client that can, vanilla, is told them
  # and offers them), and every class for every race. Unset: the game's races
  # and classes.
  # open_races: true
  # all_classes: true
  # The game's ten races' skin shades (entity/skinshades.go): a skin row under
  # the create page's four and at select's Customize, for a client that shows
  # it (vanilla); a PS2 draws the race's own skin. Unset: none.
  # skin_shades: true
  # The barbarians' tattoo (entity/tattoos.go): a Tattoo row (off, bands or
  # crest, the disc's woad) on any barbarian face, man or woman, for a client
  # that draws it (vanilla); a PS2 draws the face chosen. Unset: none.
  # tattoos: true
  # The worlds of the disc's own zones this server offers to clients that build
  # them off their own disc (vanilla): cmd/worldbuild writes worldN.ESF and
  # worldN.json into the worlds folder from the operator's disc first
  # (tools/worlds/homelands.json is the Homelands, slot 10), then groundbake
  # -world 10=worlds/world10.ESF its ground. None unless listed.
  # server_worlds: [10]

  # Capture the flag (entity/ctf.go, handlers/ctf.go): an arena world of the
  # server's own (built by cmd/worldbuild and listed in server_worlds), joined
  # at the PvP Events herald beside Dabrish (tools/place_ctf_herald.py) or with
  # /ctf join. Two arenas are kept: slot 12, the Spirit Ring
  # (tools/worlds/ring.json: a round hollow, the default), and slot 11, the
  # Canyon of Banners (tools/worlds/arena.json: the first, much larger field).
  # Only the one `world` names is played; a world a server does not play need
  # not be in server_worlds (every client builds each listed world). Off unless
  # enabled; every number left out is its default (shown here;
  # claude-notes/ctf-world-20261110.md, ctf-ring-20261111.md).
  # ctf:
  #   enabled: true
  #   world: 12
  #   team_size: 10       # the most a team holds
  #   min_per_team: 2     # the fewest a team starts with
  #   score_limit: 3      # captures that win
  #   time_limit: 20m     # then the higher score wins, a tie a draw
  #   wave_every: 30s     # the dead rise together at their camp
  #   wave_min_dead: 5s
  #   countdown: 30s      # from enough signed up to the start
  #   prep: 30s           # in the arena before the banners go live
  #   end_hold: 15s       # from the end to everyone sent back
  #   flag_return: 30s    # a dropped banner left alone goes home
  #   wound_after: 4m     # a carrier past this takes more from every hit
  #   wound_step: 25      # percent more, and as much again each further minute
  #   wound_max: 200      # the most more, in percent
  #   powerup_every: 60s  # a taken power-up comes back
  #   speed_for: 20s      # the speed shrine's boost lasts
  #   min_level: 1
  #   touch_reach: 5

  # The siege of Zentar's Keep (entity/siege.go, handlers/siege.go): the second
  # arena game, capture the flag's engine in a world of its own (slot 15,
  # tools/worlds/siege.json: Tunaria zone 22's castle where it stands; built by
  # cmd/worldbuild and listed in server_worlds). The same PvP Events herald
  # signs players up (or /siege join); the defenders keep King Zentar alive in
  # the courtyard, the attackers break the Outer and Inner Gate (the gatehouse's
  # doors) and slay him. The King and the gates are copies of spawn-only NPCs
  # (tools/siege_20261112.py). A GM's #siege start|stop|time <m>|teams <n> runs
  # it by hand. Off unless enabled; every number left out is its default, as
  # capture the flag's (score_limit, flags, wounds and power-ups unread)
  # (claude-notes/siege-world-20261112.md).
  # siege:
  #   enabled: true
  #   world: 15
  #   team_size: 10
  #   min_per_team: 2
  #   time_limit: 20m     # then the defenders win
  #   wave_every: 30s
  #   countdown: 30s
  #   prep: 30s
  #   end_hold: 15s
  #   king_hp: 100000     # King Zentar's hit points
  #   gate_hp: 30000      # each gate's

  # The players' homes (entity/homes.go, handlers/homes.go): a world of the
  # server's own (built by cmd/worldbuild from tools/worlds/homesteads.json,
  # slot 13, the Homesteads: a fenced cottage on a crater's rim, invisible
  # blockers outside its fence, and listed in
  # server_worlds) of which every character has its own copy, free. The Real
  # Estate Listings board beside Dabrish and its twin in every yard
  # (tools/place_homes_board_20261111.py) and /home go home, visit a friend's
  # home and leave; /home invite, uninvite, kick, list. Only a client that holds
  # the world goes in (vanilla). Off unless enabled; world unset is 13
  # (claude-notes/player-homes-20261111.md).
  # homes:
  #   enabled: true
  #   world: 13

  # The instanced raid dungeons (entity/dungeons.go, handlers/dungeons.go): a
  # world of the server's own (built by cmd/worldbuild from
  # tools/worlds/dungeons.json, slot 14, the Dungeons: the disc's Blackburrow,
  # Runnyeye with Misty Thicket before its gate, and Guk, where they stand on
  # Tunaria; listed in server_worlds) whose creatures (its npcs rows, written by
  # tools/dungeons_20261112.py) each raid, group or lone player fights in a copy
  # of its own. A group's leader (or a player alone) opens its party's instance
  # at a Dungeon Warden (beside Dabrish, and the way out at each entrance) or
  # with /dungeon enter <name>; its members follow into it. An instance no one
  # stands in for close_after closes (its creatures gone); max_instances may be
  # open at once. Only a client that holds the world goes in (vanilla). Off
  # unless enabled; world unset is 14 (claude-notes/dungeon-world-20261112.md).
  # dungeons:
  #   enabled: true
  #   world: 14
  #   close_after: 30m
  #   max_instances: 30

  # How many records the pack (worn items among them, as CLIENT's 40 counts
  # them) and the bank hold for a client that holds more (vanilla, offered them
  # with opcode 0x7E29). Unset or 40: CLIENT's 40, nothing offered; at most 255.
  # A PS2 always holds 40: a character with more is sent its first 40 (worn
  # items always), the rest kept for it until a client that holds them logs in.
  # pack_slots: 100
  # bank_slots: 100

  # A cape slot of this server's own (entity/capes.go): items of wear slot 28
  # (tools/seed_capes.py makes them) worn in equip slot 22, drawn by a client
  # that draws capes (vanilla, offered them with opcode 0x7E25); a PS2 is sent
  # a cape as a plain item it cannot wear. Off unless set.
  # capes: true

  # The Rock of Freeport (handlers/rockfreeport.go): the server makes its record
  # at its start, every character holding none is given one at its login, and
  # its Use is a 2 s cast in Return Home's visual to a few steps in front of
  # Dabrish. Off unless set (the Heirloom Test Server sets it).
  # rock_of_freeport: true

  # The Testing Heroes (entity/heroes.go, handlers/heroes.go): every kill that
  # gives a character experience gives it 1 standing with the faction Testing
  # Heroes, a raid boss's 5; the faction starts at the floor, -2000, and the
  # Testing Heroes Vendor sells for the standing above it. The faction, the
  # vendor (by the well behind Dabrish), his stock and its items are
  # tools/seed_testing_heroes.py's. Off unless set (the Heirloom Test Server
  # sets it): no credit, no faction in the window, no vendor.
  # testing_heroes: true

  # A magician's water pet heals the worst off of its side, not only its owner
  # or itself (entity/petmemberheal.go): its single-target heals land on the
  # lowest share of hit points below the heal's threshold among its owner,
  # itself, the owner's group or raid group's players within the heal's reach
  # (not one in a fight of its own: a duel, PvP) and their pets and
  # mercenaries. Off unless set (the Heirloom Test Server sets it): its owner
  # or itself, as before.
  # pet_heal_group: true

  # The quest marks on a client's map (handlers/questmarks.go, vanilla's Quest
  # Markers): a giver's "!" only for quests whose lowest level is at most this
  # many below the player's (a quest's name is marked once, at its nearest
  # giver, either way). Unset or 0: 10 (a level 60 is shown quests for 50 and
  # up); -1: every quest the player may take, however low.
  # quest_marks_below: 10

  # The most NPCs and players (the player's own among them) a client that
  # keeps more than the game's 24 may have in view, and the farthest they are
  # looked for: eqoa-rust-client-vanilla's Options > Extended > NPC/PC Display
  # and NPC/PC View Distance ask for theirs once the server offers these
  # (opcode 0x7E00). max_entity_slots unset or 0: every state channel the
  # protocol has, 204; 24: none past the game's. max_view_distance unset or 0:
  # 1000; 300: no farther than every client's. A PS2 always has 24 within 300.
  # max_entity_slots: 128
  # max_view_distance: 600

  # The sun on a vampire (table charvampire: #vampire and the GM panel make
  # one): vampire_sun_damage (50, Sandstorm's; 0 none) every
  # vampire_sun_interval (6s) while its client shows the sun up (6:00 to
  # 18:00); vampire_sun_shade false burns it under a roof too (true: shade,
  # anything over it, shelters it); vampire_sun_gms false spares a GM's
  # vampire. The GM panel's settings change them while the server runs.
  # vampire_sun_damage: 50
  # vampire_sun_interval: 6s
  # vampire_sun_shade: true
  # vampire_sun_gms: true

  # The towns' boon (entity/boon.go): talking to a town's announcement board
  # gives the player boon_xp_pct percent of every experience award (kills,
  # quests; 200: double; 100: the boards give none) for boon_duration of play.
  # The GM panel's settings change both while the server runs.
  # boon_xp_pct: 200
  # boon_duration: 4h

  # A line every player in the world gets when the server stops (a restart:
  # SIGTERM from systemctl, or the GM panel's restart), restart_notice_wait
  # (5s when unset) before the game goes back to its login. Unset: none.
  # restart_notice: "Restarting Server, log back in 20 seconds."
  # restart_notice_wait: 5s
  # The line a login is sent once on how to report a bug (#bug, /bug, vanilla's
  # F3, Support in the start menu: handlers/bugreport.go). On unless false.
  # report_notice: false
  # The welcome guide (handlers/welcome.go): a character's first world entry of
  # a UTC day asks, in a box, whether the player would like a guide of the
  # server or never to be asked again on that character; /tutorial shows the
  # box at any time. On unless false.
  # welcome_guide: false
  # The players' camp reports (/campfix, /mark, /markadd, /markremove:
  # handlers/campfix.go), filed with a work board entry for a GM's review and
  # changing no spawn. On unless false.
  # campfix: false
  # The check of a player's own moves (entity/movecheck.go): off takes every
  # 0x40 as before; log (unset) takes every one and logs the rest (MOVECHECK);
  # enforce leaves a player where it was last right and moves the client back.
  # #movecheck off|log|enforce changes it while the server runs.
  # movecheck: log
  # How many zones of the ground files stay loaded (and as many of the walls
  # files'): unset or 0 keeps every zone once read (all six worlds 652 MB at
  # most, 2.4 MB a zone on average); a small machine may cap it, at the cost of
  # reading zones again when players spread over more than it holds.
  # ground_zones: 0

patch:
  # Directory holding the client patch payloads. A relative path resolves
  # against the working directory first, then against the executable's
  # directory.
  dir: "patches"

  # THE MANIFEST IS THE FOLDER patches/serve/. Every file in it is offered to
  # the client under its own name -- the name it will have on the memory card --
  # so adding a file is a copy and removing one is a delete. Nothing here lists
  # them.
  #
  # Two things that surprise people:
  #
  #   * Removing a file from serve/ does NOT remove it from a card that already
  #     has it. The patcher only acts on what the manifest names. Put the name
  #     in patches/serve/.delete to reclaim the space.
  #   * eqahosts.txt is GENERATED from server_ip and must not be in serve/.
  #
  # The three settings below are OVERRIDES and are normally left unset. Each
  # names a file in patches/ -- the pool of variants beside the folder -- to be
  # served under that LocalName instead of the folder's copy. They exist for a
  # rollback or a single-variable bisect, and EQOA_SS_FILE / EQOA_S2_FILE /
  # EQOA_SD_FILE do the same without a config edit, so a bisect is a restart.
  #
  #   ss_file: "ss-s2boot.dat"      Sandstorm's own bootstrap
  #   s2_file: "S2-race10-nohelm"   the sharpest single-variable control
  #   sd_file: "SD-hddnpc"          the assembly SD payload, console-proved
  #   sd_file: "SD-hdd-mc0"         the HDD chain with NO world fetcher
  #
  # Do NOT reach for the bare "SD" to fix a problem: that is the retired
  # memory-card build, with nine world-table entries and no HDD chain at all.
  # Serving it takes the hard-disk worlds away with no error anywhere.

  # World ESFs served to the in-game stager, NOT to the patcher -- the patcher
  # only ever writes to the memory card, and it has finished running long
  # before pfs0: is mounted, so a world can only reach the hard disk from
  # inside the running game. Slot N is the file worldN.ESF, for slots 8-29.
  #
  # No world is shipped: they are lifted from your own retail disc. Empty is
  # fine -- every disc world still works, and the server says so at startup.
  worlds_dir: "worlds"

  # UDP port the in-game stager fetches world chunks on. A protocol of ours,
  # not HTTP: the EE parses no HTTP, and the patcher's own HTTP client is
  # unloaded by the time our payload exists. 0 disables the listener.
  #
  # Delivery of both this address and the payload is sequenced per console:
  # the patcher compares by SIZE, and eqahosts.txt is fifteen bytes for almost
  # every operator ("5.161.217.188" and "192.168.40.87" are the same length),
  # so without that a card patched by another server keeps its address forever.
  # EQOA_REFRESH_FILES="SD" narrows it back, "none" turns it off.
  #
  # THE PORT IS BAKED INTO THE SD PAYLOAD and nothing on the console can
  # discover it, so changing this needs a rebuilt SD to match
  # (`make_hdd_sd.py --world-port N`). The server compares the two at startup
  # and says so if they differ. The ADDRESS is not baked: the payload reads it
  # off the memory card, out of eqahosts.txt, which this server writes from
  # server_ip -- so world downloads reach whatever the game itself connects to,
  # and there is no second address to keep in step. One consequence: server_ip
  # must be a dotted quad for world downloads to work at all. The game resolves
  # a host NAME; the payload has no resolver.
  worlds_udp_port: 7003

  # What the news box says after Play EQOA, on the way to the server list,
  # on every client: plain text, a tag would be shown as written; \n breaks a
  # line. Unset: "Welcome to Spire."
  # news: "Welcome to Spire."

auth:
  # Cost factor for password hashing (bcrypt). 4-31; outside that it falls back
  # to 10. Higher is slower to crack and slower to log in.
  bcrypt_cost: 10

  # An unknown username registers itself on first login, adopting the password
  # it presented. Convenient for a private server. Set false to allow only the
  # accounts already in the database -- then add players via auth.accounts below
  # or the signup page on account_port.
  allow_auto_register: true

  # Require a completed TCP login before the UDP handshake will accept a
  # username. Leave this on: the UDP handlers take the username straight out of
  # the packet, so without it a client can skip the auth server entirely and
  # name any account, which makes the password check pointless.
  require_tcp_login: true

  # How long a completed login stays usable for the UDP handshake. It needs to
  # cover a player sitting on the server-select and character-select screens.
  ticket_ttl: 15m

  # One login at a time: a login is refused while the same account, or a
  # session from the same address, is already in the game (the first window
  # keeps playing; no multiboxing). Off (false), an account and an address may
  # play several windows; a character is in one window at a time either way:
  # character select refuses it to a second window, which may choose another
  # (CLIENT's word 676), and the first keeps playing. The address rule skips loopback,
  # server_ip and these (IPs or CIDR prefixes): the operators' own addresses,
  # and a web relay's when relay_lookup is not set. The same addresses are
  # not counted by address by the login limit (8 failed logins an account, 20
  # an address, every 15 minutes, always on); their account names still are.
  one_login: true
  one_login_exempt: []
  # wsrelay's -lookup listener: which page is behind a relayed player, so the
  # address rule sees a browser player's own address. Without it every browser
  # player has the relay's (server_ip, exempt above).
  # relay_lookup: "http://127.0.0.1:8792"
  # relay_addrs: []   # the relay's source addresses besides server_ip

  # Accounts created at startup if they do not already exist, with the password
  # hashed. An account that already exists is left untouched, so changing a
  # password here does NOT reset one already in the database.
  accounts:
    - username: "test"
      password: "changeme"

gm:
  # The GM panel (internal/gmweb): a web page for GMs, and the same tools for
  # an AI agent (MCP with OAuth, or OpenAPI with a token). Off unless port is
  # set. Bind it to loopback and put a TLS proxy in front (nginx): it is the
  # whole server's admin.
  # port: 8081
  # bind: "127.0.0.1"

  # Where GMs and AI clients reach it, without a trailing slash: the OAuth
  # issuer, the cookie's path, and (https) whether the cookie is Secure. A
  # host name of its own is best: no other page then shares its origin, and
  # its cookie is a __Host- one no other host can set.
  # public_url: "https://gm.example.org"

  # acctlevel to sign in (the in-game # commands' 1), and to use the admin
  # tools: raw SQL, these settings, backups, a restart, other accounts' levels
  # (which also need a sign-in with an authenticator code).
  # min_level: 1
  # admin_level: 2

  # Every GM must enrol an authenticator app before the panel does anything.
  # require_totp: false

  # The log the panel shows the end of, and where its backups go (beside the
  # database when relative); a sanitised snapshot waits in its snapshots/
  # (owner-only) until its link is used or expires.
  # log_path: "gameserver.log"
  # backup_dir: "backups"

  # A browser session left alone this long ends; an API token may make this
  # many requests a minute.
  # session_idle: 2h
  # token_rate: 240

  # The spell-visual preview the Spell visuals page frames: a human casting a
  # visual as the game plays a cast's 0x00B1, off the GM's own disc, so a
  # visual can be tried without logging in. It is eqoa-rust-client-vanilla's
  # web/fxview.html, served with its play page; that host must let this panel
  # frame it (nginx: Content-Security-Policy "frame-ancestors <public_url's
  # origin>" on that one file). Empty: no preview.
  # preview_url: "https://example.org/eqoa/play/fxview.html"

# The server list, the same in every process (unset: this server alone, as
# "Marr's Fist"). A name is 31 characters at most; the list shows sorted by name;
# recommended is where a client with no home shard in the list starts. A shard
# beside the one that owns the accounts: its auth_port, patch_port, account_port and
# worlds_udp_port 0, auth.shared_db naming the owner's database (read only; a copy of
# its accounts here), world.heirlooms false if it gives no kept items. CLAUDE.md, "Shards".
# shards:
#   - name: "First Shard"
#     port: 10070
#   - name: "Second Shard"
#     port: 10071
#     recommended: true
