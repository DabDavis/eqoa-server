server:
  game_port: 10070
  auth_port: 9735
  patch_port: 7000
  account_port: 8080

  bind_address: "0.0.0.0"

  # REQUIRED. The address the CLIENT is told to connect to -- it goes into the
  # server list and into the patch XML, so it must be reachable from the PS2 /
  # PCSX2 host. It is NOT necessarily bind_address, and it is never "localhost".
  #
  # If the PS2's address is an alias on this same machine, bind_address must be
  # the specific address too, not 0.0.0.0: a UDP socket bound to 0.0.0.0 can
  # reply from the wrong local address, and the client silently drops it. TCP is
  # unaffected, so the symptom is auth and patching working while the server
  # list stays empty.
  server_ip: "192.168.1.100"

  # SQLite database file. Start from the open database (README, "A database":
  # eqoa-open-<date>.db.gz from the Releases page, unpacked as eqoa.db).
  db_path: "eqoa.db"

  # Applied to the patch server's HTTP listener.
  read_timeout: 5s
  write_timeout: 5s

  # Every packet's own debug lines in the log (received, sent, DRDP, state
  # channels): about 100 lines a second a player, so off unless set. A GM's
  # #packetlog turns them on or off while the server runs. cmd/movereplay reads
  # a log written with them on.
  # packet_log: false

  # What the process holds beyond what it uses. gc_percent is GOGC (unset: Go's
  # 100, the heap floats to twice what is live; 25 costs next to nothing here, nearly
  # all that is live being the NPCs). no_huge_pages stops the kernel's transparent
  # huge pages, which on "always" fill back what the runtime gives up.
  # gc_percent: 25
  # no_huge_pages: true

  # Go's profiler (net/http/pprof) at this address, for finding what a slow
  # tick spends its time on. Loopback only: it is no one else's. Unset: off.
  # pprof_addr: "127.0.0.1:6061"

world:
  tick_rate: 100ms

  # Time a session may sit at character select before it is dropped. The 45s
  # default is not enough for a human reading the list.
  session_timeout_pre: 300s
  session_timeout_game: 2s

  # Lets players flag themselves for PvP with /pvp (or /t pvp from a PS2): two
  # flagged players can attack each other anywhere. Off unless set.
  # pvp: true

  # The body a female vampire wears in Vampire Form, a model id (hex or
  # decimal). Unset: the human woman's, 0x0D537335 (Vampire Tserrina's look).
  # Live uses the Dawn Maiden's, 0xD7540FDA. The male form never changes.
  # vampire_female_body: 0x0D537335

  # Lets players jump (entity/jump.go): a client that can (vanilla, opcode
  # 0x7E28) is offered it and jumps about 0.9 up, and the check of players' own
  # moves takes a jump's arc from it. A PS2 cannot jump and is never offered it.
  # Off unless set.
  # jump: true

  # A coachman's offer to sign every stable's ledger at once
  # (handlers/coachledger.go). Off unless set: each ledger is signed only by
  # talking to its own coachman, so players make the coach runs (petition
  # 5114). Ledgers already signed stay signed either way.
  # coach_sign_all: true

  # A monster spawns carrying each weapon and the shield its row holds only at
  # a chance, rolled at every spawn, and a creature killed holding one drops
  # the catalog's record of that look for its level (entity/heldgear.go,
  # handlers/helddrop.go). Named creatures (a capitalised name on at most
  # held_named_rows rows), bosses' and other loot profiles', guards, NPCs,
  # pets and mercenaries always carry their whole kit. On unless set false.
  # held_gear: true
  # held_weapon_chance: 50
  # held_shield_chance: 40
  # held_named_rows: 3
  # held_chances:
  #   "gnoll scout": {weapon: 80, shield: 0}
  # What a held piece drops: its look's plain record (no stat, resist, proc or
  # use, not Lore, No Trade or No Rent), or 1 in held_rare_one_in deaths its
  # rare one (0: never), either of a levelreq at most held_level_window levels
  # under the creature's level and held_level_above over it, the nearest. A
  # look with rare records alone drops nothing but on the rare roll.
  # held_rare_one_in: 500
  # held_level_window: 5
  # held_level_above: 2

  # A monster's name and level, and nothing else, when a player presses the
  # talk button on it (square; Q on vanilla's keyboard) and it has nothing to
  # say, or stands out of the talk's reach (handlers/mobinfo.go). Vanilla
  # (offered it with opcode 0x7E4C) shows them in the target's details box, as
  # a player's, while the button is held; a PS2 in a dialogue box. Off unless
  # set.
  # mob_info: true

  # A creature's details and loot chart (handlers/mobdetails.go): vanilla
  # (offered it with opcode 0x7EFA) opens them on a right click on a creature:
  # its name, level, class, consider colour, hit points, and what its corpse
  # can hold with each item's chance a kill, read off the loot tables, its
  # region's categories and the quests' loot steps. Not on a vanilla_ui shard
  # nor to an [OG] character. Off unless set.
  # mob_details: true

  # A target's level, for every player (handlers/conlevel.go): /con (a PS2's "/t con") says "<name> is level N." of the player's
  # target, and vanilla (offered it with opcode 0x7E70) shows the level in its
  # target box beside the name. Off unless set: /con is then an unknown command.
  # con_level: true

  # The game's own UI (handlers/vanillaui.go; the Vanilla Test shard, the owner
  # 2026-11-18): none of the server's quality-of-life offers (others' power,
  # the pet's effects, the buff window, number colours, the DPS meter, the
  # monster's details, the target box's level, quest marks, tracker and head
  # marks), /con an unknown command, and vanilla told (opcode 0x7EA0) to turn
  # off its own (quest helper, stat caps, auto-cast, bars 3-4...) and to start
  # the map, minimap and item links off. Off unless set.
  # vanilla_ui: true
  # Follow (vanilla's /follow and quick command): false tells vanilla
  # (opcode 0x7EA0, bit 15) to follow group members only, as the game does
  # (Live petition 5400, the owner 2026-11-21: group only on Live). Unset, or
  # set to true, any player can follow any player (Heirloom).
  # follow_any_player: false

  # [OG] characters (handlers/ogaccount.go, database/ogchar.go; the Vanilla
  # Test shard, the owner 2026-11-18, a character's since 2026-11-19): a new
  # character chooses [OG] (vanilla's create page, else the game's question box
  # after Hardcore's); an [OG] character plays here with the game's own UI:
  # none of the server's quality-of-life offers, /con unknown, no item links,
  # and vanilla told (0x7EA0) every addition off, the map and links locked, no
  # mouse, no touch; drawn "[OG] Name" to everyone. At the first start with it,
  # the characters of the old [OG] accounts (accountinfo.og) become [OG]
  # characters, once. Off unless set.
  # og_accounts: true
  # The most Combat Mastery points a character holds, spent and unspent
  # together (entity.MasteryCap): Heirloom 2000, the Live shard 1500.
  # mastery_cap: 2000
  # The most Combat Mastery points a character below level 60 holds for each
  # of its levels (entity.MasteryPerLevel); past it, its experience goes to its
  # level (all of it to the masteries: lost). Unset: 25 (the live game's: the
  # Live shard). 0: no cap by level, so 100% to masteries never levels
  # (Heirloom).
  # mastery_per_level: 25
  # The share of the carried tunar a death to a creature or the world takes
  # (entity/deathtunar.go): never at a PvP death or a duel's, in a CTF arena,
  # or from the bank. Unset: 50 (half, as the live game); 0 turns it off.
  # death_tunar_pct: 50

  # [HC] Hardcore characters (handlers/hardcore.go; the owner, 2026-11-18):
  # chosen for a character when it is made (vanilla's create page; a PS2's first
  # world entry asks in a question box, or /t hardcore), for good; drawn
  # "[HC] Name"; its first real death is final (no respawn, no rez), the
  # character then a locked memorial on its player's list, on the Memorial of
  # the Fallen in Freeport (tools/memorial_fallen_20261118.py) and on the page
  # at /fallen (this shard's and other_db's). Off unless enabled.
  # hardcore:
  #   enabled: true
  #   shard: "First Shard"         # its name on the page and the memorial (unset: none)
  #   fall_logout_seconds: 15      # the fall to the client's login
  #   other_db: "/srv/eqoa-second/eqoa.db"   # another shard's database, read-only (unset: none)
  #   other_mark: "Second Shard"
  #   site_name: "example.com"     # the page's title and footer name it (unset: "this server")

  # The auction house's standing lots (handlers/auction_perpetual.go): lots
  # that never end and never run out, a buy at the price putting the items in
  # the buyer's bank and leaving the lot up (tools/ah_materials_20261114.py
  # puts the crafting materials up, seller "ilovetesters"). Off unless set:
  # such lots are then left out of every search and refused as closed.
  # perpetual_auctions: true
  # A GM's #reward (/reward) as the reward of experience: 10% more experience
  # for 30 minutes of play on the GM's target, a player (handlers/rewardxp.go,
  # petition 5033). Unset: #reward is GM's Reward, the buff (handlers/reward.go).
  # gm_reward_xp: true

  # The accounts (accountinfo.username) whose GMs may /noclip: a flight through
  # every wall, floor and ceiling (handlers/noclip.go). Empty: nobody.
  # noclip_accounts: [someaccount]

  # The accounts (accountinfo.username) that may /grpsummon though they are no
  # GM's: every other member of their group or raid brought to them
  # (handlers/grpsummon.go). A GM and a sub GM always may. Empty: GMs and sub
  # GMs alone. Such an account (a sub GM too) waits grpsummon_cooldown seconds between two (unset: 60; 0: none; a GM: none).
  # grpsummon_accounts: [someaccount]
  # grpsummon_cooldown: 60

  # The regional weather (internal/weather, #1549): rain, snow and sandstorms
  # by the ground under each 500x500 square (<worlds_dir>/ground/<world>.profiles,
  # cmd/groundbake -only-profiles; tables weatherprofiles, weatherzones,
  # weatherclimates, tools/seed_weather.py), on a clock, and GMs' #weather.
  # Unset: on. false: no weather at all, nothing sent, #weather says it is off.
  # weather: false

  # What an NPC says when talked to, by name, in place of the debug box
  # (ServerID, HP, position...) every other NPC opens.
  npc_text:
    "Freeport Announcements": "Welcome to the server."

  # For testing: the level a new character starts at (1 when unset; a
  # client's creation message never chooses it), and whether it starts with
  # every spell its class has (the classspells table, filled by
  # tools/import_class_spells.py).
  # start_level: 50
  # start_all_spells: true

  # Character creation past the game's own (entity/creation.go): the froglok
  # and every race of table racedefs (a client that can, vanilla, is told them
  # and offers them), and every class for every race. Unset: the game's races
  # and classes.
  # open_races: true
  # all_classes: true
  # The game's ten races' skin shades (entity/skinshades.go): a skin row under
  # the create page's four and at select's Customize, for a client that shows
  # it (vanilla); a PS2 draws the race's own skin. Unset: none.
  # skin_shades: true
  # The barbarians' tattoo (entity/tattoos.go): a Tattoo row (off, bands or
  # crest, the disc's woad) on any barbarian face, man or woman, for a client
  # that draws it (vanilla); a PS2 draws the face chosen. Unset: none.
  # tattoos: true
  # The worlds of the disc's own zones this server offers to clients that build
  # them off their own disc (vanilla): cmd/worldbuild writes worldN.ESF and
  # worldN.json into the worlds folder from the operator's disc first
  # (tools/worlds/homelands.json is the Homelands, slot 10), then groundbake
  # -world 10=worlds/world10.ESF its ground. None unless listed.
  # Neriak instanced duels use slot 16 (tools/worlds/neriak-duel.json).
  # Bake world16.ESF into worlds/ground to enable its four damaging lava pockets.
  # server_worlds: [10, 16]

  # Capture the flag (entity/ctf.go, handlers/ctf.go): an arena world of the
  # server's own (built by cmd/worldbuild and listed in server_worlds), joined
  # at the PvP Events herald beside Dabrish (tools/place_ctf_herald.py) or with
  # /ctf join. Three arenas are kept: slot 12, the Spirit Ring
  # (tools/worlds/ring.json: a round hollow, the default), slot 11, the
  # Canyon of Banners (tools/worlds/arena.json: the first, much larger field),
  # and slot 17, the Lightwolf Vale (tools/worlds/lightwolf.json: Castle
  # Lightwolf against the werewolves' village south of it, as large a field).
  # Only the one `world` names is played; a world a server does not play need
  # not be in server_worlds (every client builds each listed world). Off unless
  # enabled; every number left out is its default (shown here;
  # claude-notes/ctf-world-20261110.md, ctf-ring-20261111.md).
  # ctf:
  #   enabled: true
  #   world: 12
  #   team_size: 10       # the most a team holds
  #   min_per_team: 2     # the fewest a team starts with
  #   score_limit: 3      # captures that win
  #   time_limit: 20m     # then the higher score wins, a tie a draw
  #   wave_every: 30s     # the dead rise together at their camp
  #   wave_min_dead: 5s
  #   countdown: 30s      # from enough signed up to the start
  #   prep: 30s           # in the arena before the banners go live
  #   end_hold: 15s       # from the end to everyone sent back
  #   flag_return: 30s    # a dropped banner left alone goes home
  #   wound_after: 4m     # a carrier past this takes more from every hit
  #   wound_step: 25      # percent more, and as much again each further minute
  #   wound_max: 200      # the most more, in percent
  #   powerup_every: 60s  # a taken power-up comes back
  #   speed_for: 20s      # the speed shrine's boost lasts
  #   min_level: 1
  #   touch_reach: 5

  # The siege of Zentar's Keep (entity/siege.go, handlers/siege.go): the second
  # arena game, capture the flag's engine in a world of its own (slot 15,
  # tools/worlds/siege.json: Tunaria zone 22's castle where it stands; built by
  # cmd/worldbuild and listed in server_worlds). The same PvP Events herald
  # signs players up (or /siege join); the defenders keep King Zentar alive in
  # the courtyard, the attackers break the Outer and Inner Gate (the gatehouse's
  # doors) and slay him. The King and the gates are copies of spawn-only NPCs
  # (tools/siege_20261112.py). A GM's #siege start|stop|time <m>|teams <n> runs
  # it by hand. Off unless enabled; every number left out is its default, as
  # capture the flag's (score_limit, flags, wounds and power-ups unread)
  # (claude-notes/siege-world-20261112.md).
  # siege:
  #   enabled: true
  #   world: 15
  #   team_size: 10
  #   min_per_team: 2
  #   time_limit: 20m     # then the defenders win
  #   wave_every: 30s
  #   countdown: 30s
  #   prep: 30s
  #   end_hold: 15s
  #   king_hp: 100000     # King Zentar's hit points
  #   gate_hp: 30000      # each gate's

  # The players' homes (entity/homes.go, handlers/homes.go): a world of the
  # server's own (built by cmd/worldbuild from tools/worlds/homesteads.json,
  # slot 13, the Homesteads: a fenced cottage on a crater's rim, invisible
  # blockers outside its fence, and listed in
  # server_worlds) of which every character has its own copy, free. The Real
  # Estate Listings board beside Dabrish and its twin in every yard
  # (tools/place_homes_board_20261111.py) and /home go home, visit a friend's
  # home and leave; /home invite, uninvite, kick, list. Only a client that holds
  # the world goes in (vanilla). Off unless enabled; world unset is 13
  # (claude-notes/player-homes-20261111.md).
  # homes:
  #   enabled: true
  #   world: 13

  # The instanced raid dungeons (entity/dungeons.go, handlers/dungeons.go): a
  # world of the server's own (built by cmd/worldbuild from
  # tools/worlds/dungeons.json, slot 14, the Dungeons: the disc's Blackburrow,
  # Runnyeye with Misty Thicket before its gate, and Guk, where they stand on
  # Tunaria; listed in server_worlds) whose creatures (its npcs rows, written by
  # tools/dungeons_20261112.py) each raid, group or lone player fights in a copy
  # of its own. A group's leader (or a player alone) opens its party's instance
  # at a Dungeon Warden (beside Dabrish, and the way out at each entrance) or
  # with /dungeon enter <name>; its members follow into it. An instance no one
  # stands in for close_after closes (its creatures gone); max_instances may be
  # open at once. Only a client that holds the world goes in (vanilla). Off
  # unless enabled; world unset is 14 (claude-notes/dungeon-world-20261112.md).
  # dungeons:
  #   enabled: true
  #   world: 14
  #   close_after: 30m
  #   max_instances: 30
  #   cap: 4              # players in a dungeon's instance (a dungeon's own cap wins)
  #   raid_cap: 50        # players in a raid's instance
  #   lockout: 10m        # after an instance closes, who stood in it waits this long for a new one (0: off)
  #   worlds: [18]        # more built worlds (in server_worlds) whose dungeons stand in worlds of their own:
  #                       # 18 is Mythic Lord Nagafen's island (tools/worlds/mythic_nagafen.json), entered
  #                       # only at the Heroic Raids NPC (handlers/heroicraids.go)

  # How many records the pack (worn items among them, as CLIENT's 40 counts
  # them) and the bank hold for a client that holds more (vanilla, offered them
  # with opcode 0x7E29). Unset or 40: CLIENT's 40, nothing offered; at most 255.
  # A PS2 always holds 40: a character with more is sent its first 40 (worn
  # items always), the rest kept for it until a client that holds them logs in.
  # pack_slots: 100
  # bank_slots: 100

  # One bank for every character of an account, its items and its tunar, up to
  # account_bank_slots records (unset: 2000). A client is shown a page of its
  # list's size (a PS2 40, vanilla bank_slots), turned with /bank next (a PS2:
  # /t bank next). Run tools/account_bank_20261114.py --apply on the database
  # before turning it on (it merges the characters' banks; --undo parts them).
  # account_bank: true
  # account_bank_slots: 2000

  # A cape slot of this server's own (entity/capes.go): items of wear slot 28
  # (tools/seed_capes.py makes them) worn in equip slot 22, drawn by a client
  # that draws capes (vanilla, offered them with opcode 0x7E25); a PS2 is sent
  # a cape as a plain item it cannot wear. Off unless set.
  # capes: true

  # The Rock of Freeport (handlers/rockfreeport.go): the server makes its record
  # at its start, every character holding none is given one at its login, and
  # its Use is a 2 s cast in Return Home's visual to a few steps in front of
  # Dabrish. Off unless set.
  # rock_of_freeport: true

  # Heirloom Marks (handlers/marks.go): marks below 60, or while a 60 relives at a
  # Rehabilitator, for quests and kills; the Hot zones (table hotzones, #hotzone, the
  # Hot Zone Herald), /marks, the Heirloom Keeper (Ring of Guises, Heirloom Rank to
  # 55, Mastery Tomes). Its records and NPCs are data (tools/heirloom_marks_*.py).
  # Off unless set.
  # heirloom_marks: true

  # Heirloom only. Froglok refugees from Guk hear extra lines in their class quests.
  # froglok_refugee_dialogue: true

  # The Testing Heroes (entity/heroes.go, handlers/heroes.go): every kill that
  # gives a character experience gives it 1 standing with the faction Testing
  # Heroes, a raid boss's 5; the faction starts at the floor, -2000, and the
  # Testing Heroes Vendor sells for the standing above it. The faction, the
  # vendor (by the well behind Dabrish), his stock and its items are
  # tools/seed_testing_heroes.py's. Off unless set: no credit, no faction in
  # the window, no vendor.
  # testing_heroes: true

  # The Bug Finder Leaderboard (handlers/bugboard.go; tools/bugboard_20261115.py
  # stands it against Freeport's well): its list counts this shard's bug and
  # crash reports and, with other_db, the other shard's too (opened read-only,
  # at most once a minute), its players marked other_mark; mark is what this
  # shard's own players are marked with (unset: none). exclude names the
  # accounts never listed (unset: a built-in list; set it to your own staff's
  # accounts); top how many are listed (unset or 0: 15, at most 50).
  # bug_board:
  #   mark: ""
  #   other_db: "/srv/eqoa-second/eqoa.db"
  #   other_mark: "Second Shard"
  #   exclude: [youradmin]
  #   top: 15

  # A magician's water pet heals the worst off of its side, not only its owner
  # or itself (entity/petmemberheal.go): its single-target heals land on the
  # lowest share of hit points below the heal's threshold among its owner,
  # itself, the owner's group or raid group's players within the heal's reach
  # (not one in a fight of its own: a duel, PvP) and their pets and
  # mercenaries. Off unless set: its owner or itself, as before.
  # pet_heal_group: true

  # The quest marks on a client's map (handlers/questmarks.go, vanilla's Quest
  # Markers): a giver's "!" only for quests whose lowest level is at most this
  # many below the player's (a quest's name is marked once, at its nearest
  # giver, either way). Unset or 0: 10 (a level 60 is shown quests for 50 and
  # up); -1: every quest the player may take, however low.
  # quest_marks_below: 10

  # The most NPCs and players (the player's own among them) a client that
  # keeps more than the game's 24 may have in view, and the farthest they are
  # looked for: eqoa-rust-client-vanilla's Options > Extended > NPC/PC Display
  # and NPC/PC View Distance ask for theirs once the server offers these
  # (opcode 0x7E00). max_entity_slots unset or 0: every state channel the
  # protocol has, 204; 24: none past the game's. max_view_distance unset or 0:
  # 1000; 300: no farther than every client's. A PS2 always has 24 within 300.
  # max_entity_slots: 128
  # max_view_distance: 600

  # The sun on a vampire (table charvampire: #vampire and the GM panel make
  # one): vampire_sun_damage (unset 50; 0 none) every
  # vampire_sun_interval (6s) while its client shows the sun up (6:00 to
  # 18:00); vampire_sun_shade false burns it under a roof too (true: shade,
  # anything over it, shelters it); vampire_sun_gms false spares a GM's
  # vampire. The GM panel's settings change them while the server runs.
  # vampire_sun_damage: 50
  # vampire_sun_interval: 6s
  # vampire_sun_shade: true
  # vampire_sun_gms: true

  # The towns' boon (entity/boon.go): talking to a town's announcement board
  # gives the player boon_xp_pct percent of every experience award (kills,
  # quests; 200: double; 100: the boards give none) for boon_duration of play.
  # The GM panel's settings change both while the server runs.
  # boon_xp_pct: 200
  # boon_duration: 4h

  # A line every player in the world gets when the server stops (a restart:
  # SIGTERM from systemctl, or the GM panel's restart), restart_notice_wait
  # (5s when unset) before the game goes back to its login. Unset: none.
  # restart_notice: "Restarting Server, log back in 20 seconds."
  # restart_notice_wait: 5s
  # The line a login is sent once on how to report a bug (#bug, /bug, vanilla's
  # F3, Support in the start menu: handlers/bugreport.go). On unless false.
  # report_notice: false
  # The welcome guide (handlers/welcome.go): a character's first world entry of
  # a UTC day asks, in a box, whether the player would like a guide of the
  # server or never to be asked again on that character; /tutorial shows the
  # box at any time. On unless false.
  # welcome_guide: false
  # The players' camp reports (/campfix, /mark, /markadd, /markremove:
  # handlers/campfix.go), filed with a work board entry for a GM's review and
  # changing no spawn. On unless false.
  # campfix: false
  # The check of a player's own moves (entity/movecheck.go): off takes every
  # 0x40 as before; log (unset) takes every one and logs the rest (MOVECHECK);
  # enforce leaves a player where it was last right and moves the client back.
  # #movecheck off|log|enforce changes it while the server runs.
  # movecheck: log
  # How many zones of the ground files stay loaded (and as many of the walls
  # files'): unset or 0 keeps every zone once read (all six worlds 652 MB at
  # most, 2.4 MB a zone on average); a small machine may cap it, at the cost of
  # reading zones again when players spread over more than it holds.
  # ground_zones: 0

  # --- New characters and accounts ---

  # The purse a new character is created with (database/newchar.go). Unset:
  # 5000; 0: none.
  # start_tunar: 5000

  # How many characters an account may hold (entity/charslots.go). A client
  # whose select page scrolls (vanilla) may make that many; a PS2, whose page
  # holds 8, is sent the 8 most recently played and may make none past 8.
  # Unset or 0: 20; at most 64.
  # max_characters: 20

  # --- Creatures, corpses and loot ---

  # Creatures attack a player on sight (entity/aggro.go). Unset: they do; set
  # false, none attacks first.
  # aggro: true
  # An NPC of a faction (table npcfaction) attacks, and shows its con face, by
  # the player's standing with it. Unset: it does; false: no faction counts.
  # faction_aggro: true

  # How long a creature's corpse lies when nothing empties it (unset or 0: 3m),
  # and how long after its corpse goes the creature comes back (unset or 0:
  # 60s). roam_radius is how far from its spawn a creature wanders (unset or
  # 0: 70; below 0, none wander). entity/corpse.go, entity/roam.go.
  # corpse_decay: 3m
  # respawn_after: 60s
  # roam_radius: 70
  # How long after its death a raid's kill's corpse is its kill group's alone, then
  # anyone's (unset or 0: 6m; below 0, always its group's: entity/corpseopen.go),
  # and how long a raid's lootable corpse lies from its death (unset or 0: 20m; at or
  # below corpse_decay, none lingers: entity/corpselinger.go).
  # corpse_open_after: 6m
  # corpse_decay_after: 20m
  # Outside a raid (entity/corpsesolo.go): a lootable corpse lies corpse_decay_solo
  # (unset or 0: 10m; below 0 the rule off, every corpse under the raid's rules),
  # its creature down with it until it goes; it is anyone's after
  # corpse_open_after_solo (unset or 0: 7m); an opening puts its decay back to the
  # full time, corpse_checks_max times a death (unset or 0: 10; below 0 none).
  # corpse_decay_solo: 10m
  # corpse_open_after_solo: 7m
  # corpse_checks_max: 10

  # What a thrown potion and a ranged weapon's shot cost the thrower or
  # shooter, a percent of its most power (entity/potion.go,
  # entity/rangedpower.go). Unset: 10; 0: none.
  # throw_power_pct: 10
  # ranged_power_pct: 10

  # Lava (entity/lava.go): a player with its feet in lava loses
  # lava_pct_max_hp percent of its most hit points plus lava_damage (at least
  # 1) at once and every lava_interval (unset or 0: 3s) it stays;
  # lava_fire_resist lets its fire resistance take its share. Both amounts
  # unset or 0: lava burns no one (the default). The dead and GMs never burn.
  # lava_pct_max_hp: 0
  # lava_damage: 0
  # lava_interval: 3s
  # lava_fire_resist: false

  # The percent of its experience a one-time quest's step gives (not a
  # repeatable or hunt-and-gather quest: handlers/questxp.go). Unset, 0 or
  # 100: as the quest rows say; 400: four times.
  # quest_xp_pct: 100

  # --- Items and the post ---

  # The kept items given at login to a character holding none, while their
  # records exist in the database (handlers/genie.go, wolffang.go,
  # summonportal.go, jarofbreath.go). Unset: given; false: none.
  # heirlooms: true

  # Gear a character transfer brought in: its copy keeps imported_share of its
  # base record's stats, procs and worn hit effects (unset: 0.85), and
  # imported_tag shows "(Imported)" after its name (unset: off).
  # imported_share: 0.85
  # imported_tag: false

  # The tunar the post takes for a gram that carries an item or tunar
  # (handlers/mailattach.go), on top of what it carries; text alone is free.
  # Unset or 0: none.
  # mail_postage: 0

  # When pack_slots or bank_slots is lowered: set these to the old size and a
  # character already holding more keeps (and is sent) every item, but takes
  # no new record until it is under the new limit (entity/itemslots.go).
  # Unset or not above the limit: off.
  # grandfather_pack_slots: 0
  # grandfather_bank_slots: 0

  # The pack and bank of an [OG] character's session (world.og_accounts), at
  # most these; every other session pack_slots and bank_slots. Unset (0): the
  # same as everyone's.
  # og_pack_slots: 40
  # og_bank_slots: 40

  # The Weapon Enchanter's price for one aura on a held weapon
  # (handlers/enchanter.go): enchanter_price of the item record named
  # enchanter_token (enchanter_token_id: the record's id, when no record has
  # the name) from the pack. Unset: 1 "Holly Token"; a price of 0: free.
  # enchanter_price: 1
  # enchanter_token: "Holly Token"
  # enchanter_token_id: 0

  # --- Optional extras (each off unless set; most need their NPC or items
  # placed by the tool named) ---

  # The Teleporter (handlers/teleporter.go; tools/place_teleporter.py): an NPC
  # that sends a player to every raid's way in and beside every XP camp, free.
  # teleporter: true

  # /testinvis, every player's safe mode (handlers/safemode.go): typed, no
  # creature attacks the character on sight until it is typed again.
  # testinvis: true

  # The familiars (handlers/familiar.go; tools/seed_familiars.py): an item of
  # table familiars calls its familiar; /familiar dismiss sends it away.
  # familiars: true

  # The mercenaries (handlers/merc.go; tools/place_merc_liaisons.py): a
  # Mercenary Liaison hires one free, a member of its owner's group,
  # commanded by /merc. An alchemist merc at ease brews merc_brew_batch
  # potions (unset or 0: 20) every merc_brew_seconds (unset or 0: 5) once it
  # and its owner have stood still merc_brew_settle_seconds (unset or 0: 3),
  # to a full stack of each potion; merc_brew_stack above 0 holds each stack
  # to that, merc_brew_cap above 0 caps the whole stock (unset: no cap; 0:
  # none brewed). merc_draught_hp_floor_pct is the share of its health it
  # keeps when it drinks for power (unset: 50).
  # mercs: true
  # Percent to remove from melee and caster mercenaries' outgoing damage,
  # including their pets (0-100, default 0). Set to 25 for 75% damage.
  # merc_dps_reduction_pct: 0
  # merc_brew_seconds: 5
  # merc_brew_batch: 20
  # merc_brew_settle_seconds: 3
  # merc_brew_stack: 0
  # merc_brew_cap: 0
  # merc_draught_hp_floor_pct: 50

  # Two shards only: the accounts whose GM edits of NPC rows here (/place,
  # /clone, /copy, then /move, /roamer, /size, /delete of such a row) are
  # written to the other shard's database mirror_npc_db too, which that
  # server reads in within seconds (handlers/npcmirror.go). Unset: nothing
  # is mirrored.
  # mirror_npc_edits_accounts: [youradmin]
  # mirror_npc_db: "/srv/eqoa-second/eqoa.db"

patch:
  # Directory holding the client patch payloads. A relative path resolves
  # against the working directory first, then against the executable's
  # directory.
  dir: "patches"

  # THE MANIFEST IS THE FOLDER patches/serve/. Every file in it is offered to
  # the client under its own name -- the name it will have on the memory card --
  # so adding a file is a copy and removing one is a delete. Nothing here lists
  # them.
  #
  # Two things that surprise people:
  #
  #   * Removing a file from serve/ does NOT remove it from a card that already
  #     has it. The patcher only acts on what the manifest names. Put the name
  #     in patches/serve/.delete to reclaim the space.
  #   * eqahosts.txt is GENERATED from server_ip and must not be in serve/.
  #
  # The three settings below are OVERRIDES and are normally left unset. Each
  # names a file in patches/ -- the pool of variants beside the folder -- to be
  # served under that LocalName instead of the folder's copy. They exist for a
  # rollback or a single-variable bisect, and EQOA_SS_FILE / EQOA_S2_FILE /
  # EQOA_SD_FILE do the same without a config edit, so a bisect is a restart.
  #
  #   ss_file: "ss-s2boot.dat"      an older bootstrap, for a bisect
  #   s2_file: "S2-race10-nohelm"   the sharpest single-variable control
  #   sd_file: "SD-hddnpc"          the assembly SD payload, console-proved
  #   sd_file: "SD-hdd-mc0"         the HDD chain with NO world fetcher
  #
  # Do NOT reach for the bare "SD" to fix a problem: that is the retired
  # memory-card build, with nine world-table entries and no HDD chain at all.
  # Serving it takes the hard-disk worlds away with no error anywhere.

  # World ESFs served to the in-game stager, NOT to the patcher -- the patcher
  # only ever writes to the memory card, and it has finished running long
  # before pfs0: is mounted, so a world can only reach the hard disk from
  # inside the running game. Slot N is the file worldN.ESF, for slots 8-29.
  #
  # No world is shipped: they are lifted from your own retail disc. Empty is
  # fine -- every disc world still works, and the server says so at startup.
  worlds_dir: "worlds"

  # UDP port the in-game stager fetches world chunks on. A protocol of ours,
  # not HTTP: the EE parses no HTTP, and the patcher's own HTTP client is
  # unloaded by the time our payload exists. 0 disables the listener.
  #
  # Delivery of both this address and the payload is sequenced per console:
  # the patcher compares by SIZE, and eqahosts.txt is fifteen bytes for almost
  # every operator ("203.0.113.100" and "198.51.100.17" are the same length),
  # so without that a card patched by another server keeps its address forever.
  # EQOA_REFRESH_FILES="SD" narrows it back, "none" turns it off.
  #
  # THE PORT IS BAKED INTO THE SD PAYLOAD and nothing on the console can
  # discover it, so changing this needs a rebuilt SD to match
  # (`make_hdd_sd.py --world-port N`). The server compares the two at startup
  # and says so if they differ. The ADDRESS is not baked: the payload reads it
  # off the memory card, out of eqahosts.txt, which this server writes from
  # server_ip -- so world downloads reach whatever the game itself connects to,
  # and there is no second address to keep in step. One consequence: server_ip
  # must be a dotted quad for world downloads to work at all. The game resolves
  # a host NAME; the payload has no resolver.
  worlds_udp_port: 7003

  # What the news box says after Play EQOA, on the way to the server list,
  # on every client: plain text, a tag would be shown as written; \n breaks a
  # line. Unset: "Welcome to Spire."
  # news: "Welcome to Spire."
  # changes_file: ""   # the patcher's release notes (Changes.txt), plain text, re-read at each request; unset: built-in notes

auth:
  # Cost factor for password hashing (bcrypt). 4-31; outside that it falls back
  # to 10. Higher is slower to crack and slower to log in.
  bcrypt_cost: 10

  # An unknown username registers itself on first login, adopting the password
  # it presented. Convenient for a private server. Set false to allow only the
  # accounts already in the database -- then add players via auth.accounts below
  # or the signup page on account_port.
  allow_auto_register: true

  # og_choice is RETIRED (2026-11-19): [OG] is a character's now
  # (world.og_accounts); no account page offers it. A config that still sets
  # it loads, and the server logs that it is ignored. Leave it out.
  # og_choice: false

  # Require a completed TCP login before the UDP handshake will accept a
  # username. Leave this on: the UDP handlers take the username straight out of
  # the packet, so without it a client can skip the auth server entirely and
  # name any account, which makes the password check pointless.
  require_tcp_login: true

  # How long a completed login stays usable for the UDP handshake. It needs to
  # cover a player sitting on the server-select and character-select screens.
  ticket_ttl: 15m

  # The address the account server (server.account_port: the account pages,
  # register, password, e-mail) listens on. This example serves the pages
  # through a TLS proxy on the same machine. Set a different interface for
  # a remote proxy. Empty or unset listens on every address.
  bind_address: "127.0.0.1"

  # One login at a time: a login is refused while the same account, or a
  # session from the same address, is already in the game (the first window
  # keeps playing; no multiboxing). Off (false), an account and an address may
  # play several windows; a character is in one window at a time either way:
  # character select refuses it to a second window, which may choose another
  # (CLIENT's word 676), and the first keeps playing. The address rule skips loopback,
  # server_ip and these (IPs or CIDR prefixes): the operators' own addresses,
  # and a web relay's when relay_lookup is not set. The same addresses are
  # not counted by address by the login limit (8 failed logins an account, 20
  # an address, every 15 minutes, always on); their account names still are.
  one_login: true
  one_login_exempt: []
  # wsrelay's -lookup listener: which page is behind a relayed player, so the
  # address rule sees a browser player's own address. Without it every browser
  # player has the relay's (server_ip, exempt above).
  # relay_lookup: "http://127.0.0.1:8792"
  # relay_addrs: []   # the relay's source addresses besides server_ip
  # The most of an account's characters in the game through the web relay at
  # once (0: no limit; native clients are not counted). Needs relay_lookup.
  # browser_characters: 0

  # The account pages' password page as players reach it, named in the line a
  # player with a GM-set temporary password is told. Unset: "the account
  # website's Change password page".
  # password_url: "account.example.com/password"

  # Two shards only, on the shard that does NOT own the accounts: the owning
  # shard's database, whose accountinfo is copied here (read-only, never
  # written back) at each sign-in and every shared_refresh (unset or 0: 10s).
  # Unset on the shard that owns them.
  # shared_db: "/srv/eqoa-first/eqoa.db"
  # shared_refresh: 10s

  # Accounts created at startup if they do not already exist, with the password
  # hashed. An account that already exists is left untouched, so changing a
  # password here does NOT reset one already in the database.
  # accounts:
  #   - username: "your-account"
  #     password: ""  # set a unique password before enabling this entry

# combat: off by default; every key below is shown at its default.
#
# formula_file names an operator's own damage formula file, kept on the server's
# machine and never in the repository (docs/damage-formulas.md has the format).
# Unset or "", and formula_mode "off" (or ""): the built-in damage everywhere,
# which is what a new server should run. The formula_shadow_* and formula_*
# keys only matter with a formula file loaded; see docs/damage-formulas.md.
#
# resist_model is what a resist takes off elemental (FR/CR/LR/AR/PR/DR) spell
# and effect damage (internal/entity/elemental.go): "elemental-2026-11-14"
# (unset: it), or "legacy", the model before it, for a rollback. resist_mode
# is the player's: magnitude_only (unset), fixed_full_chance
# (resist_full_chance of the hits land whole) or resistance_scaled (a resist
# holds R/350 of the time, a template's resist_fail making it fail more; with
# resist_partial true a failure is a partial at R/350 again, else whole). A
# resist below 0 adds R/350 to the hit in every elemental mode. The model in
# force is logged at the start ("Resists: model").
# combat:
#   formula_file: ""
#   formula_mode: "off"
#   formula_shadow_log: ""
#   formula_shadow_sample: 0      # 0: every hit, when shadowing
#   formula_shadow_max_mb: 64
#   formula_shard: ""
#   formula_peers: {}
#   resist_model: "elemental-2026-11-14"
#   resist_mode: "magnitude_only"
#   resist_full_chance: 0
#   resist_partial: false         # resistance_scaled only (both shards: true)

gm:
  # The GM panel (internal/gmweb): a web page for GMs, and the same tools for
  # an AI agent (MCP with OAuth, or OpenAPI with a token). Off unless port is
  # set. Bind it to loopback and put a TLS proxy in front (nginx): it is the
  # whole server's admin.
  # port: 8081
  # bind: "127.0.0.1"

  # Where GMs and AI clients reach it, without a trailing slash: the OAuth
  # issuer, the cookie's path, and (https) whether the cookie is Secure. A
  # host name of its own is best: no other page then shares its origin, and
  # its cookie is a __Host- one no other host can set.
  # public_url: "https://gm.example.org"

  # acctlevel to sign in (the in-game # commands' 1), and to use the admin
  # tools (raw SQL, these settings, backups, a restart, other accounts' levels,
  # which also need a sign-in with an authenticator code).
  # min_level: 1
  # admin_level: 2

  # Every GM must enrol an authenticator app before the panel does anything.
  # require_totp: false

  # The log the panel shows the end of, and where its backups go (beside the
  # database when relative); a sanitised snapshot waits in its snapshots/
  # (owner-only) until its link is used or expires.
  # log_path: "gameserver.log"
  # backup_dir: "backups"

  # A browser session left alone this long ends; an API token may make this
  # many requests a minute.
  # session_idle: 2h
  # token_rate: 240

  # The spell-visual preview the Spell visuals page frames: a human casting a
  # visual as the game plays a cast's 0x00B1, off the GM's own disc, so a
  # visual can be tried without logging in. It is eqoa-rust-client-vanilla's
  # web/fxview.html, served with its play page; that host must let this panel
  # frame it (nginx: Content-Security-Policy "frame-ancestors <public_url's
  # origin>" on that one file). Empty: no preview.
  # preview_url: "https://example.org/eqoa/play/fxview.html"

  # Personal boards: a private thread between one GM (and that GM's AI
  # agents, signed in as the account) and the operator's sessions on the box
  # (cmd/workboard: workboard board alice, workboard post alice "..."). A board's name (a-z,
  # 0-9, - and _) to the panel accounts that may read and post it; the
  # admins (admin_level) read and post every board, no other GM reads one.
  # The panel's ops: my_boards, board_messages, post_board_message. Read at
  # the panel's start. Unset: no boards.
  # Two shards only: another shard's database, opened read-only by the
  # Economy page so it shows that shard's ledger beside this one's, under
  # economy_other_name. Unset: this shard's alone.
  # economy_other_db: "/srv/eqoa-second/eqoa.db"
  # economy_other_name: "Second Shard"

  # personal_boards: {alice: [alicegm]}

  # One panel for several shards on one machine (gmweb/forward.go). Every
  # operation, on the page, over MCP and at api/op/<name>, takes an optional
  # "shard": shard_id (or nothing) runs it here, another shard's name hands it
  # to that shard's own panel at url, as the GM who called, judged there by
  # that shard's account and audited there. The page gets a switch.
  # shard_id is this panel's name in that argument, shard_label its switch's.
  # shard_id: "heirloom"
  # shard_label: "Heirloom"
  # other_shards:
  #   - name: "live"
  #     label: "Live"
  #     url: "http://127.0.0.1:8082"
  #     key_file: "/home/eqoa/gm-shard.key"
  # On the shard that is handed calls: the same key, in a file both read
  # (owner-only; 32 random bytes or more: openssl rand -hex 32). A call is
  # taken from a loopback address alone, never through the proxy. Empty:
  # this panel takes none.
  # shard_key_file: "/home/eqoa/gm-shard.key"
  #
  # Two-way player chat uses this same Heirloom -> Live panel route. Set
  # gm.shard_id to "heirloom" on Sandbox and "live" on Vanilla. Heirloom's
  # live peer uses Live's direct loopback URL and key_file. Live reads the
  # matching shard_key_file. The two game servers reconnect automatically.
  # A remote shout or tell shows v.Name or s.Name. Both /tell vanilla.Name and
  # /tell sandbox.Name accept the long forms. A bare name stays local. /reply
  # uses the short address shown to the recipient.

# The quest engine (handlers/quests.go).
# quests:
#   # The journal's pointer to a finished quest's next quest at another giver
#   # (handlers/questpointers.go). Unset: on.
#   next_giver_pointer: true
#   # Which quests show a "!" and "?" over their NPCs' heads, on a client that
#   # draws them (handlers/questheadmarks.go): "flagged" (unset) the quests of
#   # table questmarks, "all" every quest, "off" none.
#   markers: "flagged"

# Account e-mail (internal/accountmail): verification and e-mailed password
# resets. Everything is off unless set; a fresh server does not need it.
# accounts turns the features on (the account page's E-mail tab, the forgot
# password link, an address asked for where an account is made). enabled
# sends through the SMTP relay; false only logs each message (log_bodies the
# whole text, links included: a developer's box only). require_verified
# reminds an account with no verified address at each world entry and every
# remind_every, and from require_after (a date, UTC) refuses its login.
#
# base_url (the site every link names) and, with enabled, from (the sender)
# have no default: with accounts on and either missing, the server logs a
# warning at startup and turns the e-mail (and require_verified) off rather
# than mail links to a site that is not yours. smtp defaults to 127.0.0.1:25.
# page_path is the password page on base_url (unset:
# /eqoa/password; with the account pages on a host of their own, as in
# docs/hosting.md, "/password").
# mail:
#   accounts: false
#   enabled: false
#   log_bodies: false
#   smtp: "127.0.0.1:25"            # local relay. A remote relay needs STARTTLS (TLS 1.2+) and a trusted certificate for its host.
#   from: "no-reply@example.com"
#   base_url: "https://account.example.com"
#   page_path: "/password"
#   require_verified: false
#   require_after: ""               # e.g. "2027-01-31"
#   remind_every: 30m

# The server list, the same in every process (unset: this server alone, as
# "Marr's Fist"). A name is 31 characters at most; the list shows sorted by name;
# recommended is where a client with no home shard in the list starts. A shard
# beside the one that owns the accounts: its auth_port, patch_port, account_port and
# worlds_udp_port 0, auth.shared_db naming the owner's database (read only; a copy of
# its accounts here), world.heirlooms false if it gives no kept items. CLAUDE.md, "Shards".
# shards:
#   - name: "First Shard"
#     port: 10070
#   - name: "Second Shard"
#     port: 10071
#     recommended: true
#     ip: "203.0.113.20"   # unset: server.server_ip
